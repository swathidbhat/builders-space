{
  "name": "builders-space",
  "version": "1.0.0",
  "description": "Ambient awareness dashboard for multi-agent coding work",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
